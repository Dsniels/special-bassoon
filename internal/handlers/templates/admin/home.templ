{{define "title"}}Productos Managment{{end}}
{{define "scripts"}}
<script>

</script>
{{end}}
{{define "body"}}

<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between m-4 ">
    <h2 class="text-3xl font-bold text-green-900 mb-6">Productos</h2>
    <div class="m-2">
      <a href="/admin/servicios/create/0"
        class="inline-block bg-green-900 text-white font-semibold px-8 py-3 rounded-lg hover:bg-green-800 transition-colors">
        Agregar Producto
      </a>
    </div>
  </div>
  {{if eq (len .Servicios) 0}}
  <div class="text-center py-10 text-gray-600">
    Vuelve Despues
  </div>
  {{else}}
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {{range .Servicios}}
    <div class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow flex flex-col h-full">
      <a href="/servicios/{{.ID}}">
        <div class="h-48 overflow-hidden">
          <img src="{{.Imagen}}" alt="{{.Nombre}}" class="w-full h-full object-cover">
        </div>
        <div class="flex flex-col p-6 flex-grow">
          <h3 class="text-xl font-bold text-center uppercase mb-4 overflow-hidden">{{.Nombre}}</h3>
        </div>
        <div class="flex  mt-auto p-4">
          <div class="m-2">
            <form method="post" action="/admin/servicios/delete/{{.ID}}">
              <button
                class="inline-block bg-green-900 text-white font-semibold px-8 py-3 rounded-lg hover:bg-green-800 transition-colors"
                type="submit">Eliminar</button>
            </form>
          </div>
          <div class="m-2">
            <a href="/admin/servicios/create/{{.ID}}"
              class="inline-block bg-green-900 text-white font-semibold px-8 py-3 rounded-lg hover:bg-green-800 transition-colors">
              Editar
            </a>
          </div>
        </div>
      </a>
    </div>
    {{end}}
  </div>
  {{end}}
</div>

{{end}}